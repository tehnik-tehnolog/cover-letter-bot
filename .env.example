# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Gemini API Key from Google AI Studio
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Supabase PostgreSQL connection string
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Public Render service URL (enables webhook mode so the bot wakes up on incoming Telegram messages)
WEBHOOK_BASE_URL="https://<PROJECT-ID>onrender.com"

# Bot mode: "auto" (webhook if WEBHOOK_BASE_URL is set, else polling), "webhook", or "polling"
# Set BOT_MODE="polling" when testing locally in PyCharm
BOT_MODE="auto"

# HTTP server port (Render overrides this automatically; Hugging Face Spaces uses 7860)
PORT=7860
